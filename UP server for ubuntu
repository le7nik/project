# Необходимо две вещи: написать код самого сервера (например, на Python, Go, Node.js или Bash) и дать файлу права на выполнение.
# Ниже приведены 3 самых простых и популярных способа создания такого сервера.

# Вариант 1. 
# На Python (Встроенный HTTPS-сервер) Использовался SSL-сертификат (приведен ниже), напишем полноценный HTTPS-сервер на Python, который будет отдавать строку или JSON.
# Создайте файл (например, в каталоге /opt/app):bashsudo nano /opt/app/server.py
# Вставьте код (он автоматически подтянет созданные вами ранее server.crt и server.key):

python#!/usr/bin/env python3
import http.server
import ssl

server_address = ('0.0.0.0', 8443) # Порт 8443 (или 443)
httpd = http.server.HTTPServer(server_address, http.server.SimpleHTTPRequestHandler)

# Привязываем SSL-сертификаты
context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
context.load_cert_chain(certfile="server.crt", keyfile="server.key")
httpd.socket = context.wrap_socket(httpd.socket, server_side=True)

print(f"Сервер запущен на https://{server_address[0]}:{server_address[1]}")
httpd.serve_forever()

# Дделаем файл делаем исполняемым:bashsudo chmod +x /opt/app/server.py

# Первая строка #!/usr/bin/env python3 (шебанг) указывает Ubuntu, что этот файл нужно запускать именно через Python.

# Вариант 2. На Node.js (JavaScript)Отличный вариант, если вам нужен быстрый REST API сервер.Создайте файл:bashsudo nano /opt/app/server.js
# Вставить код:
javascript#!/usr/bin/env node
const https = require('https');
const fs = require('fs');

const options = {
  key: fs.readFileSync('server.key'),
  cert: fs.readFileSync('server.crt')
};

const server = https.createServer(options, (req, res) => {
  res.writeHead(200, { 'Content-Type': 'application/json' });
  res.end(JSON.stringify({ status: "success", message: "Hello from Ubuntu!" }));
});

server.listen(8443, '0.0.0.0', () => {
  console.log('Сервер запущен на https://0.0.0');
});

# Делаем файл исполняемым:
bashsudo chmod +x /opt/app/server.js

# Вариант 3. Бинарный файл в расширении .bin (Компиляция из Go)Если вам нужен именно монолитный бинарный файл (как в вашем задании server.bin), который не требует установленного Python или Node.js, проще всего скомпилировать его на языке Go.Установите Go (если его нет): sudo apt install golang -y Создайте файл main.go:gopackage main

import (
    "fmt"
    "net/http"
)

func handler(w http.ResponseWriter, r *http.Request) {
    w.Header().Set("Content-Type", "application/json")
    fmt.Fprintf(w, `{"status": "success"}`)
}

func main() {
    http.HandleFunc("/", handler)
    fmt.Println("Сервер запущен на https://0.0.0")
    // Запуск HTTPS с вашими сертификатами
    http.ListenAndServeTLS(":8443", "server.crt", "server.key", nil)
}
# Скомпилировать его в готовый .bin файл:
bashgo build -o /opt/app/server.bin main.go
#Cделать его исполняемым:
bashsudo chmod +x /opt/app/server.bin

# Как теперь изменить службу systemd? Если создано, например, server.py вместо server.bin, просто открыть конфигурацию службы из прошлого шага (sudo nano /etc/systemd/system/myserver.service) и замените строку запуска:iniExecStart=/opt/app/server.py
# После этого обновить службу: sudo systemctl daemon-reload && sudo systemctl restart myserver.

