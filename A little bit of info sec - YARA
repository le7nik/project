Сохраните это правило в отдельный файл. 
{
    meta:
        description = "Обнаружение утилит для несанкционированного дампа памяти процессов (LSASS)"
        author = "Студень"
        category = "Post-Exploitation / Credentials Theft"
        severity = "High"

    strings:
        // Системная функция Windows, необходимая для создания дампа памяти (минидампа)
        $api_dump = "MiniDumpWriteDump" ascii

        // Характерные строки, используемые в утилитах дампа памяти (например, Dumpert)
        $str_lsass = "lsass.exe" wide ascii nocase
        $str_dump_file = "lsass.dmp" wide ascii nocase
        
        // Артефакты работы с дескрипторами процессов для чтения памяти
        $api_open = "OpenProcess" ascii
        $api_read = "ReadProcessMemory" ascii

        // Шестнадцатеричная сигнатура вызова прямого системного syscall (часто используется для обхода антивирусов)
        // Код инструкции: mov eax, [sys_number]; syscall
        $hex_syscall = { B8 ?? ?? 00 00 0F 05 }

    condition:
        // Файл должен быть исполняемым (MZ заголовок)
        uint16(0) == 0x5A4D and 
        
        // Критерий срабатывания: наличие функции дампа и целевого процесса, либо использование скрытых системных вызовов
        (
            ($api_dump and $str_lsass) or 
            ($api_read and $api_open and $str_lsass) or
            (all of ($str_* ) and $hex_syscall)
        )
}
Это правило загружается в систему EDR (Endpoint Detection and Response) на каждом конечном компьютере.
Если злоумышленник попытается запустить скрытый скрипт или модуль, который ищет в памяти пароли, YARA мгновенно заблокирует этот процесс.
Даже если локальный компьютер скомпрометирован, сетевые барьеры (микросегментация) не позволят хакеру отправить этот дамп памяти за пределы текущего отдела.
